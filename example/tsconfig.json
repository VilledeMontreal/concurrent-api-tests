{
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,

    // todo: remove when lib is used from registry
    "noImplicitAny": false,
    // Avoid importing vitest in each test file
    "types": ["vitest/globals"]
  }
}
