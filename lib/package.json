{
  "name": "@villedemontreal/concurrent-api-tests",
  "version": "2.0.0",
  "description": "Provides the core functions required to implement concurrent API tests with vitest.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist/**.*.js",
    "/dist/**.*d.ts"
  ],
  "directories": {
    "lib": "./dist"
  },
  "scripts": {
    "open-watch-mode-no-emit-in-a-second-screen-for-fast-feedback": "tsc --noEmit --watch --pretty",
    "start": "vitest run",
    "package": "tsc",
    "lint": "villemontreal-lint . check node both",
    "lint-fix": "villemontreal-lint . fix node both",
    "prettier": "villemontreal-lint . check node prettier",
    "prettier-fix": "villemontreal-lint . fix node prettier",
    "tslint": "villemontreal-lint . check node tslint",
    "tslint-fix": "villemontreal-lint . fix node tslint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VilledeMontreal/concurrent-api-tests.git"
  },
  "homepage": "https://github.com/VilledeMontreal/concurrent-api-tests",
  "keywords": [
    "vitest",
    "api",
    "test",
    "spec",
    "concurrency",
    "parallel",
    "async"
  ],
  "author": "Stéphane Leblanc",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "4.2.19",
    "@types/lodash": "4.14.170",
    "@types/node": "^18.0.0",
    "@villedemontreal/lint-config": "1.7.5",
    "chai": "4.3.4",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "lodash": "4.17.21",
    "mocha.parallel": "github:steph-lebl/mocha.parallel#feature/enable-retries",
    "serialize-error": "8.1.0",
    "uuid": "8.3.2"
  },
  "bugs": {
    "url": "https://github.com/VilledeMontreal/mocha-concurrent-api-tests/issues"
  }
}
