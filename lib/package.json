{
  "name": "@villedemontreal/concurrent-api-tests",
  "version": "2.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Provides the core functions required to implement concurrent API tests with vitest.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "directories": {
    "lib": "./dist/src"
  },
  "scripts": {
    "watch-no-emit": "tsc --noEmit --watch --pretty",
    "start": "vitest run",
    "package": "tsc",
    "lint-fix": "prettier --write . && eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VilledeMontreal/concurrent-api-tests.git"
  },
  "homepage": "https://github.com/VilledeMontreal/concurrent-api-tests",
  "keywords": [
    "vitest",
    "api",
    "test",
    "spec",
    "concurrency",
    "parallel",
    "async"
  ],
  "author": "Stéphane Leblanc",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/chai": "5.2.3",
    "@types/lodash": "4.17.20",
    "@types/node": "24.9.1",
    "@types/uuid": "11.0.0",
    "chai": "6.2.0",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "jiti": "2.6.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "dependencies": {
    "vitest": "4.0.3",
    "tinyrainbow": "3.0.3",
    "lodash": "4.17.21",
    "uuid": "13.0.0"
  },
  "bugs": {
    "url": "https://github.com/VilledeMontreal/concurrent-api-tests/issues"
  }
